# =========================================================================
# Android & Gradle Git Ignore Rules
# =========================================================================

# Gradle build output & caches
.gradle/
build/
app/build/
**/build/
.externalNativeBuild
.cxx/

# Local configuration files (contains local SDK path, local environment settings)
local.properties

# Android Studio & IntelliJ IDEA workspace files
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches/
.idea/modules.xml
.idea/compiler.xml
*.iml

# Keystore & Signing files
*.jks
*.keystore
*.p12

# Compiled Android artifacts
*.apk
*.aar
*.ap_
*.aab

# Android Studio Captures & Navigation
captures/
.navigation/

# OS specific files
.DS_Store
Thumbs.db

# Logs & Temporary files
*.log
tmp/

# Google Services / Sensitive API Keys
google-services.json

# Antigravity CLI / Local cache files (Keep skills, agent.md, rules)
.gemini/tmp/
.gemini/history/

# Local scratch HTML for design exploration only (not part of the product)
sample/
